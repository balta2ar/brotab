{
  "description": "Control your browser's tabs from command line",
  "manifest_version": 2,
  "name": "BroTab",
  "version": "2.0.15",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "128": "brotab-icon-128x128.png"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "brotab_mediator@example.org",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "142.0"
    }
  }
}
